# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Postgres Easypanel (projeto banco / serviço banco / database site_cruzeiro).
# Local (porta exposta):
DATABASE_HOST=168.231.99.126
DATABASE_PORT=3232
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=site_cruzeiro
DATABASE_SSL=false
# Produção no mesmo projeto Easypanel:
# DATABASE_HOST=banco_banco
# DATABASE_PORT=5432

# Kommo — cria lead no funil de vendas (Incoming) ao enviar o form.
KOMMO_BASE_URL=https://admamoeduitcombr.kommo.com
KOMMO_TOKEN=
KOMMO_PIPELINE_ID=5481944
KOMMO_STATUS_ID=48539240
# Origem-new (select) — opção Form-influencer
KOMMO_ORIGEM_NEW_FIELD_ID=686585
KOMMO_ORIGEM_NEW_ENUM_ID=452249
KOMMO_NOME_FIELD_ID=304628
KOMMO_TELEFONE_COMERCIAL_FIELD_ID=190582
