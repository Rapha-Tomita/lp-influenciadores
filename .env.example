# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Postgres Easypanel (projeto banco / serviço banco / database site_cruzeiro).
# Local (porta exposta):
DATABASE_HOST=168.231.99.126
DATABASE_PORT=3232
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=site_cruzeiro
DATABASE_SSL=false
# Produção no mesmo projeto Easypanel:
# DATABASE_HOST=banco_banco
# DATABASE_PORT=5432
# PORT=3000
# CORS_ORIGIN=*
# Opcional se o front ficar no AI Studio apontando pra API:
# VITE_API_BASE=https://seu-app.easypanel.host

# Bwipo CRM — cria contato + negócio (Pipeline Principal > Lead de Entrada),
# preenche Nome/Telefone/Origem/Grau e aplica a tag "influencers".
# Sem BWIPO_TOKEN o envio ao Bwipo fica desligado (lead só no Postgres).
BWIPO_TOKEN=
# Opcionais (os padrões já estão no código):
# BWIPO_BASE_URL=https://integrations.bwipo.com/api
# BWIPO_SOURCE=form-influencer
# BWIPO_STAGE_ID=cmu2xmns00l6vq6019s508e9j
# BWIPO_TAG_ID=cmwcil4u90b57lg01iu4w4d55
